{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is unavailable. Dictated as Normal." : {
      "comment" : "Shown after a dictation whose armed Smart Mode did not run for a reason the user cannot act on. The placeholder is the mode's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht verfügbar. Als Normal diktiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible. Dictado como Normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est indisponible. Dicté en Normal."
          }
        }
      }
    },
    "%@ needs Dictus Pro. Dictated as Normal." : {
      "comment" : "Shown after a dictation whose armed Smart Mode did not run for lack of a Pro subscription. The placeholder is the mode's name.",
