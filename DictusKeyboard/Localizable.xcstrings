          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: no se pudo aplicar. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : n’a pas pu s’appliquer. Réessayez."
          }
        }
      }
    },
