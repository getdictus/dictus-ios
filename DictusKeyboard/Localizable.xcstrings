            "state" : "translated",
            "value" : "%@ · inactif"
          }
        }
      }
    },
    "%@: Apple Intelligence does not support the dictated language (%@)." : {
      "comment" : "Shown when an armed Smart Mode could not run because the language the user dictated is outside the set Apple Intelligence reads. First placeholder is the mode's name, second is the dictated language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Apple Intelligence unterstützt die diktierte Sprache (%@) nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Apple Intelligence no admite el idioma dictado (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : Apple Intelligence ne prend pas en charge la langue dictée (%@)."
          }
        }
      }
    },
    "%@: could not be applied, text inserted as dictated." : {
      "comment" : "Shown when an armed Smart Mode was refused by a guardrail and the untransformed text was inserted instead. The placeholder is the mode's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: konnte nicht angewendet werden, Text unverändert eingefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: no se pudo aplicar, texto insertado tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : n’a pas pu s’appliquer, texte inséré tel quel."
          }
        }
      }
    },
    "%@: could not be applied. Try again." : {
      "comment" : "Shown when an armed Smart Mode fails and nothing is inserted. The placeholder is the mode's name.",
