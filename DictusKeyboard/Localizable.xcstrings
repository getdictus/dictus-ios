          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande Dictus Pro. Dicté en Normal."
          }
        }
      }
    },
    "%@ · off" : {
      "comment" : "Toolbar label for an armed Smart Mode that will not run, so the dictation goes in as Normal. The placeholder is the mode's name.",
      "localizations" : {
