        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence se prépare"
          }
        }
      }
    },
    "Apple Intelligence is ready" : {
      "comment" : "Onboarding Apple Intelligence step (#683). Shown once the re-check finds Apple Intelligence available.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist bereit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence está listo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est prête"
          }
        }
      }
    },
    "Apple Intelligence is required for polish. Enable it in iPhone Settings → Apple Intelligence & Siri. Apple requires Siri and your iPhone to use the same language — if Siri is in English and your iPhone is in French (or vice versa), Apple Intelligence stays off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist zum Verfeinern des Transkripts erforderlich. Aktiviere es in den iPhone-Einstellungen → Apple Intelligence & Siri. Apple verlangt, dass Siri und dein iPhone dieselbe Sprache verwenden: Ist Siri auf Englisch und dein iPhone auf Französisch (oder umgekehrt), bleibt Apple Intelligence deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence es necesario para pulir la transcripción. Actívalo en Ajustes del iPhone → Apple Intelligence y Siri. Apple exige que Siri y tu iPhone usen el mismo idioma: si Siri está en inglés y tu iPhone en francés (o al revés), Apple Intelligence permanece desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est nécessaire pour polir la transcription. Activez-la dans Réglages → Apple Intelligence et Siri. Apple exige que Siri et votre iPhone utilisent la même langue : si Siri est en anglais et votre iPhone en français (ou l’inverse), Apple Intelligence reste désactivée."
          }
        }
      }
    },
    "Apple Intelligence is still downloading. Smart Modes will work once it finishes." : {
      "comment" : "Shown in the Smart Mode fan while the on-device model is downloading.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence lädt noch sein Modell. Die Modi funktionieren danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is still downloading. Smart Modes will work once it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún está descargando su modelo. Los modos funcionarán después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence télécharge encore son modèle. Les modes marcheront ensuite."
          }
        }
      }
    },
    "Apple Intelligence is unavailable (%@)." : {
      "comment" : "Polish footer in Settings when Apple Intelligence is unavailable for a reason Dictus does not name (#792). The argument is Apple's raw reason.",
