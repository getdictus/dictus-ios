    },
    "This voice note is no longer available." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message vocal n’est plus disponible."
          }
        }
      }
    },
    "This voice note is too long for Apple Intelligence to summarise." : {
      "comment" : "Voice note result: the transcript exceeds Apple Intelligence's context (#620).",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message vocal est trop long pour être résumé par Apple Intelligence."
          }
        }
      }
    },
    "To hear you while you dictate. The sound is transcribed on your iPhone and never leaves it." : {
      "comment" : "Onboarding microphone pre-permission screen: why the microphone is needed, shown before the system prompt (#675, #649 decision 17).",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous entendre pendant la dictée. Le son est transcrit sur votre iPhone et n'en sort jamais."
          }
        }
      }
    },
    "To keep Smart Modes, History and Vocabulary afterwards, you will need a Dictus Pro subscription." : {
      "comment" : "Trial announcement disclosure (#593): what it takes to keep Pro after the trial. Deliberately names no price.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour garder ensuite les modes intelligents, l'historique et le vocabulaire, il faudra un abonnement Dictus Pro."
