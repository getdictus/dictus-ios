      }
    },
    "In Settings, open Apple Intelligence & Siri, then Language, and choose your iPhone's language." : {
      "comment" : "Onboarding Apple Intelligence step (#683). VoiceOver label of the drawn Settings page, iOS 26.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne in den Einstellungen „Apple Intelligence & Siri“, dann „Sprache“, und wähle die Sprache deines iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes, abre Apple Intelligence y Siri, luego Idioma, y elige el idioma de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages, ouvrez Apple Intelligence et Siri, puis Langue, et choisissez la langue de votre iPhone."
          }
        }
      }
    },
    "In Settings, open Keyboards, then turn on Dictus and Full Access." : {
      "comment" : "Onboarding keyboard step subtitle (#675).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
