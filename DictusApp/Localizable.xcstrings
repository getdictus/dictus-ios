        }
      }
    },
    "To switch to lifetime, first cancel your subscription in Manage subscription." : {
      "comment" : "Dictus Pro hub: under 'Upgrade to lifetime' while the subscription still renews; the lifetime is not sold until it is cancelled (#216 decision 15).",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
