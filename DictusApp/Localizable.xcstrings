        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce terme est déjà dans votre vocabulaire."
          }
        }
      }
    },
    "This voice note is longer than 10 minutes, the longest Dictus transcribes." : {
      "comment" : "Voice note failure: over the 10-minute cap (#620).",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message vocal dépasse 10 minutes, la durée maximale que Dictus transcrit."
          }
