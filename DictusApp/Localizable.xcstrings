          }
        }
      }
    },
    "This model is not installed. Open Dictus and download it in the Models tab." : {
      "comment" : "Error shown when dictation is triggered while the selected Whisper model is missing from the local model repository (issue #249).",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
