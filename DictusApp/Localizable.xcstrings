        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle %1$@, le meilleur pour votre langue sur cet iPhone. %2$@, téléchargés dès que vous continuez. Modifiable dans Modèles."
          }
        }
      }
    },
