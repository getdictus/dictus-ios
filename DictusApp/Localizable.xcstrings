            "value" : "Soit %@ par mois"
          }
        }
      }
    },
    "The best voice model for your language and iPhone. It downloads while you finish setting up, and you can change it in Models." : {
      "comment" : "Onboarding language screen, small print under the model name and size: the model is chosen for the user, downloads in the background, and can be changed in the Models tab (#649).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das beste Sprachmodell für deine Sprache und dein iPhone. Es wird geladen, während du die Einrichtung abschließt, und du kannst es unter „Modelle“ ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mejor modelo de voz para tu idioma y tu iPhone. Se descarga mientras terminas la configuración, y puedes cambiarlo en Modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meilleur modèle vocal pour votre langue et votre iPhone. Il se télécharge pendant que vous terminez la configuration, et vous pourrez le changer dans Modèles."
          }
        }
      }
    },
    "The correct spelling" : {
      "comment" : "Section header above the canonical-spelling field.",
      "localizations" : {
