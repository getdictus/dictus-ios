{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    " " : {
      "comment" : "A placeholder text that maintains layout without consuming space.",
      "isCommentAutoGenerated" : true
    },
    "%@ model, the best for your language on this iPhone. %@, downloaded as soon as you continue. You can change it in Models." : {
      "comment" : "Onboarding language screen, small type (#675). First argument: the model's name (Parakeet v3). Second: its size (~483 MB).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell %1$@, das beste für deine Sprache auf diesem iPhone. %2$@, geladen, sobald du fortfährst. Änderbar unter „Modelle“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo %1$@, el mejor para tu idioma en este iPhone. %2$@, se descargan en cuanto continúes. Puedes cambiarlo en Modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle %1$@, le meilleur pour votre langue sur cet iPhone. %2$@, téléchargés dès que vous continuez. Modifiable dans Modèles."
          }
        }
      }
    },
    "%@ runs on your iPhone. Dictation works even without a network." : {
      "comment" : "Model preparation screen subtitle, once ready. The placeholder is the model's name (Parakeet v3) (#708).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft auf deinem iPhone. Das Diktat funktioniert auch ohne Netz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funciona en tu iPhone. El dictado funciona incluso sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tourne sur votre iPhone. La dictée marche même sans réseau."
          }
        }
      }
    },
    "%@, one payment" : {
      "comment" : "Dictus Pro hub: under 'Upgrade to lifetime'. The placeholder is the lifetime price from the App Store (#216).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, einmalige Zahlung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, pago único"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, un seul paiement"
          }
        }
      }
    },
    "%@, picked for %@ and this iPhone. After that, everything runs offline." : {
      "comment" : "Onboarding model preparation subtitle (#708). First placeholder: the model's name (Parakeet v3). Second: the spoken language with its article in French (le français, l'anglais).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, ausgewählt für %2$@ und dieses iPhone. Danach läuft alles offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, elegido para %2$@ y este iPhone. Después, todo funciona sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, choisi pour %2$@ et cet iPhone. Ensuite, tout se passe hors ligne."
