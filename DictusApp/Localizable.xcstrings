    "Tap the field, switch to the Dictus keyboard, then dictate whatever you like." : {
      "comment" : "Onboarding first dictation (#678).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Feld, wechsle zur Dictus-Tastatur und diktiere, was du möchtest."
