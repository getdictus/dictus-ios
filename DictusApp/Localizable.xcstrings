      }
    },
    "Shopping list: pharmacy, dentist, dry cleaner, and the groceries for the weekend." : {
      "comment" : "Onboarding history scene: a saved dictation. Contains the searched word 'dentist' (#680).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einkaufsliste: Apotheke, Zahnarzt, Reinigung und die Einkäufe fürs Wochenende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista de recados: farmacia, dentista, tintorería y la compra para el fin de semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de courses : pharmacie, dentiste, pressing, et les courses pour le week-end."
          }
        }
      }
    },
    "Site meeting: the window delivery is pushed back to Monday, the plumber comes on Wednesday morning, and the electrician's quote has to be approved before Friday." : {
      "comment" : "Onboarding voice notes scene: the transcript of a shared voice note, shown in the drawn keyboard's reader and inserted in the message field. A natural spoken work message (#680).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baubesprechung: Die Fensterlieferung ist auf Montag verschoben, der Installateur kommt am Mittwochvormittag, und das Angebot des Elektrikers muss vor Freitag freigegeben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunión de obra: la entrega de las ventanas se retrasa al lunes, el fontanero viene el miércoles por la mañana y hay que aprobar el presupuesto del electricista antes del viernes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réunion de chantier : la livraison des fenêtres est repoussée à lundi, le plombier passe mercredi matin, et il faut valider le devis de l’électricien avant vendredi."
          }
        }
      }
    },
    "Slide back to %@ to cancel" : {
