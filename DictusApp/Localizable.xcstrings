    "Does nothing yet. Add what Dictus writes instead." : {
      "comment" : "Subtitle of a vocabulary row stored before variants became required (#536): it has no variant, so it replaces nothing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch ohne Wirkung. Füge hinzu, was Dictus stattdessen schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hace nada. Añade lo que Dictus escribe en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans effet pour l’instant. Ajoutez ce que Dictus écrit à la place."
          }
        }
