    "If Smart Modes stay unavailable, check that Siri speaks your iPhone's language." : {
      "comment" : "Onboarding Apple Intelligence step (#683). Footnote of the getting-ready screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die intelligenten Modi nicht verfügbar bleiben, prüfe, ob Siri die Sprache deines iPhone spricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si los modos inteligentes siguen sin estar disponibles, comprueba que Siri hable el idioma de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les Smart Modes restent indisponibles, vérifiez que Siri parle la langue de votre iPhone."
          }
        }
      }
    },
    "If the page shows an Apple Intelligence switch, turn it on too." : {
      "comment" : "Onboarding Apple Intelligence step (#683). iOS 26 only: that version's page also has an Apple Intelligence switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Seite einen Apple Intelligence-Schalter zeigt, schalte ihn auch ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la página muestra un interruptor de Apple Intelligence, actívalo también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la page affiche un interrupteur Apple Intelligence, activez-le aussi."
          }
        }
      }
    },
    "In Notes, Messages or Mail: tap the mic, speak, and the text appears." : {
      "comment" : "Onboarding intro carousel, subtitle of the third page: how a dictation goes from the keyboard (#676).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Notizen, Nachrichten oder Mail: Tippe auf das Mikrofon, sprich, und der Text erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Notas, Mensajes o Mail: toca el micrófono, habla y aparece el texto."
