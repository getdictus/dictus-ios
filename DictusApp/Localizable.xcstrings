    },
    "Every dictation stays on your iPhone. Search for a word, find the text." : {
      "comment" : "Onboarding history scene: the line under the title (#680).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Diktat bleibt auf deinem iPhone. Such nach einem Wort, finde den Text."
