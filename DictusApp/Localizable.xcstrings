    },
    "Note a name and the way Dictus gets it wrong. Next time, it will write it your way." : {
      "comment" : "Onboarding vocabulary scene: the line under the title (#680).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiere einen Namen und wie Dictus ihn falsch schreibt. Beim nächsten Mal schreibt Dictus ihn so, wie du willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota un nombre y cómo lo escribe mal Dictus. La próxima vez, lo escribirá a tu manera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez un nom et la façon dont Dictus l’écrit de travers. La prochaine fois, il l’écrira à votre façon."
          }
        }
      }
    },
