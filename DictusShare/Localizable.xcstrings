      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sprachnachricht ist länger als 10 Minuten, die maximale Länge, die Dictus transkribiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje de voz dura más de 10 minutos, el máximo que Dictus transcribe."
