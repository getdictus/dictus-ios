    },
    "Open Dictus when you want to read it." : {
      "comment" : "Share extension, warm path without a Live Activity (#620).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Dictus, wenn du sie lesen möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Dictus cuando quieras leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Dictus quand vous voulez la lire."
          }
        }
      }
    },
    "Open Dictus, your voice note is waiting" : {
