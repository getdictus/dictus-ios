    "Follow it in the Dynamic Island or on the Lock Screen, and tap it when it is done." : {
      "comment" : "Share extension, warm path with a Live Activity (#620).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge sie in der Dynamic Island oder auf dem Sperrbildschirm und tippe darauf, wenn sie fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síguela en la Dynamic Island o en la pantalla bloqueada y tócala cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez-la dans la Dynamic Island ou sur l’écran verrouillé, et touchez-la quand elle est terminée."
          }
        }
      }
    },
    "OK" : {
      "extractionState" : "manual",
